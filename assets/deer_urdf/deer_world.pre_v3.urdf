  <!-- ===== URDF v2: zero-length frame bones for new DOFs ===== -->
  <!-- HAA (hip abduction/adduction) frames, body Z-axis rotation ~ lateral leg spread.
       Spine yaw frame, body Y-axis ~ torso twist for natural turning.
       Neck yaw frame, body Y-axis ~ head lateral turn. -->
  <link name="chest_yaw_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
  </link>
  <link name="HR_hip_abd">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
  </link>
  <link name="HL_hip_abd">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
  </link>
  <link name="neck_yaw_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
  </link>
  <link name="FR_hip_abd">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
  </link>
  <link name="FL_hip_abd">
    <inertial><origin xyz="0 0 0" rpy="0 0 0" /><mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" /></inertial>
  </link>

  <!-- ===== Spine: pelvis -> chest_yaw_link (Y-axis yaw) -> chest (X-axis pitch) ===== -->
  <joint name="pelvis_to_chest_yaw" type="revolute">
    <parent link="pelvis" /><child link="chest_yaw_link" />
    <origin xyz="-0.000001 0.011858 -0.177186" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.3" upper="0.3" effort="120.0" velocity="8.0" />
  </joint>
  <joint name="chest_yaw_to_chest" type="revolute">
    <parent link="chest_yaw_link" /><child link="chest" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.5" upper="0.5" effort="120.0" velocity="8.0" />
  </joint>

  <!-- ===== Hind Right hip: pelvis -> HR_hip_abd (Z-axis abduction) -> HR_thigh (X-axis flex) ===== -->
  <joint name="pelvis_to_HR_hipabd" type="revolute">
    <parent link="pelvis" /><child link="HR_hip_abd" />
    <origin xyz="-0.127008 0.189755 0.187936" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.4" upper="0.4" effort="100.0" velocity="10.0" />
  </joint>
  <joint name="HR_hipabd_to_HR_thigh" type="revolute">
    <parent link="HR_hip_abd" /><child link="HR_thigh" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.4" upper="1.4" effort="100.0" velocity="10.0" />
  </joint>

  <!-- ===== Hind Left hip: pelvis -> HL_hip_abd (Z-axis abduction) -> HL_thigh (X-axis flex) ===== -->
  <joint name="pelvis_to_HL_hipabd" type="revolute">
    <parent link="pelvis" /><child link="HL_hip_abd" />
    <origin xyz="0.127008 0.189755 0.187934" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.4" upper="0.4" effort="100.0" velocity="10.0" />
  </joint>
  <joint name="HL_hipabd_to_HL_thigh" type="revolute">
