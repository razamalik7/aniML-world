    <origin xyz="0.000010 -0.377636 -0.340136" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.000000" upper="1.000000" effort="30.0" velocity="8.0" />
  </joint>
  <joint name="HR_thigh_to_HR_shin" type="revolute">
    <parent link="HR_thigh" /><child link="HR_shin" />
