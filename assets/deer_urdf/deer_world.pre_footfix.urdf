    <origin xyz="-0.008379 0.174133 0.212941" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.600000" upper="0.300000" effort="60.0" velocity="10.0" />
  </joint>
  <joint name="HL_thigh_to_HL_shin" type="revolute">
    <parent link="HL_thigh" /><child link="HL_shin" />
    <origin xyz="-0.000001 0.232910 -0.238471" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-2.2" upper="0.0" effort="80.0" velocity="10.0" />
  </joint>
  <joint name="HL_shin_to_HL_foot" type="revolute">
    <parent link="HL_shin" /><child link="HL_foot" />
    <origin xyz="0.008379 0.174133 0.212940" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.600000" upper="0.300000" effort="60.0" velocity="10.0" />
  </joint>
  <joint name="FR_thigh_to_FR_shin" type="revolute">
    <parent link="FR_thigh" /><child link="FR_shin" />
    <origin xyz="0.000149 0.146341 0.175654" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0.0" upper="2.2" effort="80.0" velocity="10.0" />
  </joint>
  <joint name="FR_shin_to_FR_foot" type="revolute">
    <parent link="FR_shin" /><child link="FR_foot" />
    <origin xyz="0.003389 0.265206 -0.108055" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.300000" upper="1.600000" effort="60.0" velocity="10.0" />
  </joint>
  <joint name="FL_thigh_to_FL_shin" type="revolute">
