    <origin xyz="-0.000111 0.260151 -0.119765" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.300000" upper="1.600000" effort="60.0" velocity="10.0" />
  </joint>
  <!-- ===== Antlers: separate rigid body, fixed joint to skull. ===== -->
  <link name="antlers">
    <inertial><origin xyz="0.000000 -0.100000 -0.100000" rpy="0 0 0" /><mass value="1.5" />
      <inertia ixx="0.024000" ixy="0" ixz="0" iyy="0.030750" iyz="0" izz="0.030750" /></inertial>
    <collision><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="meshes/world/antler_collision_v2.stl" /></geometry></collision>
  </link>
  <joint name="skull_to_antlers" type="fixed">
    <parent link="skull" /><child link="antlers" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ===== Pasterns (fetlock joints) — v4 addition ===== -->
  <!-- Pastern: cannon (HR_foot) → hoof (HR_toe) -->
  <link name="HR_toe">
    <inertial><origin xyz="0.000000 -0.030000 -0.165000" rpy="0 0 0" /><mass value="0.25" />
      <inertia ixx="0.002433" ixy="0" ixz="0" iyy="0.002433" iyz="0" izz="0.000078" /></inertial>
    <collision><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="meshes/world/HR_toe_collision.stl" /></geometry></collision>
  </link>
  <!-- Pastern: cannon (HL_foot) → hoof (HL_toe) -->
  <link name="HL_toe">
    <inertial><origin xyz="-0.000000 -0.030000 -0.165000" rpy="0 0 0" /><mass value="0.25" />
      <inertia ixx="0.002433" ixy="0" ixz="0" iyy="0.002433" iyz="0" izz="0.000078" /></inertial>
    <collision><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="meshes/world/HL_toe_collision.stl" /></geometry></collision>
  </link>
  <!-- Pastern: cannon (FR_foot) → hoof (FR_toe) -->
  <link name="FR_toe">
    <inertial><origin xyz="0.000000 -0.023000 -0.135000" rpy="0 0 0" /><mass value="0.25" />
      <inertia ixx="0.001626" ixy="0" ixz="0" iyy="0.001626" iyz="0" izz="0.000078" /></inertial>
    <collision><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="meshes/world/FR_toe_collision.stl" /></geometry></collision>
  </link>
  <!-- Pastern: cannon (FL_foot) → hoof (FL_toe) -->
  <link name="FL_toe">
    <inertial><origin xyz="-0.000000 -0.023000 -0.135000" rpy="0 0 0" /><mass value="0.25" />
      <inertia ixx="0.001626" ixy="0" ixz="0" iyy="0.001626" iyz="0" izz="0.000078" /></inertial>
    <collision><origin xyz="0 0 0" rpy="0 0 0" /><geometry><mesh filename="meshes/world/FL_toe_collision.stl" /></geometry></collision>
  </link>
  <joint name="HR_foot_to_HR_toe" type="revolute">
    <parent link="HR_foot" /><child link="HR_toe" />
    <origin xyz="0.008378 -0.058986 -0.333707" rpy="0 0 0" />
