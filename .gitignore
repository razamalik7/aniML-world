# ---------------------------------------------------------------------------
.env
.env.local
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Experiment plumbing (2026-10). Launch configs live in experiments/launch/;
# these are the per-run logs and the queue scripts that sequenced them.
# ---------------------------------------------------------------------------
.last_*
.run_*.sh
.recollect.sh
.collect_all.sh
.arm_collect.sh
.exp_recollect.txt
.exp_run_map.txt
